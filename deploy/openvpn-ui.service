[Unit]
Description=openvpn-ui OpenVPN management API
After=network.target openvpn-server@server.service
Wants=openvpn-server@server.service

[Service]
Type=simple
User=root
Group=root
Environment=OPENVPN_UI_CONFIG=/etc/openvpn-ui/config.yaml
ExecStart=/usr/local/bin/openvpn-ui serve --config /etc/openvpn-ui/config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
