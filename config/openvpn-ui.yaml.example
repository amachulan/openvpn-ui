# Copy to /etc/openvpn-ui/config.yaml (or set OPENVPN_UI_CONFIG).
# Defaults match current angristan/openvpn-install layout.

paths:
  openvpn_server_dir: /etc/openvpn/server
  easy_rsa_dir: /etc/openvpn/server/easy-rsa
  server_conf: /etc/openvpn/server/server.conf
  client_template: /etc/openvpn/server/client-template.txt
  status_log: /var/log/openvpn/status.log
  crl_publish: /etc/openvpn/server/crl.pem
  client_output_dir: /var/lib/openvpn-ui/clients
  catalog_db: /var/lib/openvpn-ui/catalog.db
  server_conf_backup_dir: /var/lib/openvpn-ui/backups

# OpenVPN systemd unit (empty = auto-detect openvpn-server@server).
# Dual UDP+TCP: UI can enable a secondary instance; paths are persisted here.
openvpn:
  service: ""
  instances:
    udp:
      enabled: true
      conf: /etc/openvpn/server/server.conf
      service: openvpn-server@server
      port: 1194
      primary: true
      # Client .ovpn remote (when host is behind NAT). Empty = template host / listen port.
      external_host: ""
      external_port: null
    tcp:
      enabled: false
      conf: /etc/openvpn/server/server-tcp.conf
      service: openvpn-server@server-tcp
      port: 443
      primary: false
      external_host: ""
      external_port: null

# Management interface: unix socket (angristan default) or TCP.
openvpn_management:
  # socket: /var/run/openvpn-server/server.sock
  # host: 127.0.0.1
  # port: 7505
  timeout_seconds: 15

api:
  # Bind address (default: all interfaces).
  #   0.0.0.0    — VPN / LAN / public IP
  #   127.0.0.1  — local only
  #   10.8.0.1   — OpenVPN tunnel IP only
  host: 0.0.0.0
  port: 8080
  # Generate with: openssl rand -hex 32
  token: change-me

  # IP allowlist (optional). Empty = any client IP; token still required.
  allow_from: []
  # true = also allow the OpenVPN client pool from server.conf
  allow_from_vpn: false

  # Hardening example (VPN admins only):
  # allow_from_vpn: true
  # allow_from:
  #   - 127.0.0.1/32

# Optional: remind when certs expire within N days (UI + /api/v1/expiry).
expiry:
  warn_days: 30

# Optional delivery of .ovpn after issue.
# Can also be edited in the UI (Settings tab).
mail:
  enabled: false
  smtp_host: localhost
  smtp_port: 25
  smtp_user: ""
  smtp_password: ""
  use_tls: false
  from_addr: openvpn-ui@example.com
  subject: "Your OpenVPN profile"

telegram:
  enabled: false
  bot_token: ""
  # Default chat; can override per client via catalog.
  chat_id: ""
